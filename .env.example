# Alpha Pulse local secrets. Copy to .env.local; NEVER commit that file.
# Keep all trading on the Bybit DEMO environment.
BYBIT_ENV=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram notifications are opt-in; no alerts are sent until all three values are set.
# Bot token from BotFather; chat ID of your existing channel or chat.
# Add the bot as an administrator of the channel, permitted to post messages.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
